# -----------------------------------------------------------------------------
# Local development (see README.md): Docker Compose PostgreSQL + .env copy
# -----------------------------------------------------------------------------

# SQLAlchemy / psycopg3 (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://contexthub:contexthub@127.0.0.1:5433/contexthub

# Official ingest root (absolute or cwd-relative). Scanner + path-based permissions use this.
# Repo sample tree: local_nas/chatbot_docs/public/sample.txt
NAS_INBOX_ROOT=local_nas/chatbot_docs
# Windows absolute example:
# NAS_INBOX_ROOT=C:/dev/gitlab/my/ContextHub/local_nas/chatbot_docs

# NAS scan loop interval when you add a long-running worker scheduler (seconds)
SCAN_INTERVAL_SECONDS=60

# OpenSearch index name (logical name; DB search uses it only for logging in stub path)
SEARCH_INDEX_NAME=contexthub_chunks

# Chat + indexer SearchClient: `db` (default) | `opensearch_stub` (no HTTP; query/payload logging only)
SEARCH_BACKEND=db

# Reserved for real OpenSearch HTTP client (unused while SEARCH_BACKEND=db)
# OPENSEARCH_BASE_URL=https://localhost:9200

# Parser metadata stored with parse results (stub uses these)
PARSER_NAME=kordoc
PARSER_VERSION=stub-0.0.0
