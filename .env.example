# -----------------------------------------------------------------------------
# Local development (see README.md): Docker Compose PostgreSQL + .env copy
# -----------------------------------------------------------------------------

# SQLAlchemy / psycopg3 (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://contexthub:contexthub@127.0.0.1:5433/contexthub

# Official ingest root (absolute or cwd-relative). Scanner + path-based permissions use this.
# Repo sample tree: local_nas/chatbot_docs/public/sample.txt
NAS_INBOX_ROOT=local_nas/chatbot_docs
# Windows absolute example:
# NAS_INBOX_ROOT=C:/dev/gitlab/my/ContextHub/local_nas/chatbot_docs

# NAS scan loop interval when you add a long-running worker scheduler (seconds)
SCAN_INTERVAL_SECONDS=60

# OpenSearch index name (logical name; DB search uses it only for logging in stub path)
SEARCH_INDEX_NAME=contexthub_chunks

# Chat + indexer SearchClient:
#   `db` (default) | `opensearch_stub` (no HTTP) | `opensearch` (HTTP; requires OPENSEARCH_BASE_URL + index bootstrap)
SEARCH_BACKEND=db

# OpenSearch HTTP base (Compose maps host 9201 → container 9200; avoids common 9200 conflicts). Used when SEARCH_BACKEND=opensearch.
# OPENSEARCH_BASE_URL=http://127.0.0.1:9201
#
# OpenSearch container (docker-compose.yml only): OpenSearch 2.12+ requires OPENSEARCH_INITIAL_ADMIN_PASSWORD for the
# demo security bootstrap step even when plugins.security.disabled=true. That password is fixed in compose for local dev;
# it is NOT read from this file and is unrelated to OPENSEARCH_BASE_URL (the app uses unauthenticated HTTP in this dev stack).

# OpenSearch search tuning (HTTP backend only)
# OPENSEARCH_SEARCH_HIGHLIGHT=true
# OPENSEARCH_SEARCH_EXPLAIN=false

# Parser metadata stored with parse results (stub uses these)
PARSER_NAME=routing
PARSER_VERSION=stub-0.0.0

# --- LLM (POST /api/v1/chat/generate only; /chat/query stays retrieval stub) ---
# LLM_MOCK_MODE=true (default) → mock client. false → use LLM_BACKEND.
LLM_MOCK_MODE=true
# LLM_BACKEND=mock | openai_compat (used when LLM_MOCK_MODE=false)
LLM_BACKEND=mock
# LLM_MODEL=model id for OpenAI-compatible chat/completions (mock path still returns model name "mock")
LLM_MODEL=gpt-4o-mini
# HTTP timeout (seconds) for OpenAI-compatible client (urllib)
# OPENAI_COMPAT_TIMEOUT_SECONDS=120
# When LLM_MOCK_MODE=false and LLM_BACKEND=openai_compat:
# OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPAT_API_KEY=sk-...
