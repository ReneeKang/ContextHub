# -----------------------------------------------------------------------------
# Local development (see README.md): Docker Compose PostgreSQL + .env copy
# -----------------------------------------------------------------------------

# SQLAlchemy / psycopg3 (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://contexthub:contexthub@127.0.0.1:5433/contexthub

# Official ingest root (absolute or cwd-relative). Scanner + path-based permissions use this.
# Repo sample tree: local_nas/chatbot_docs/public/sample.txt
NAS_INBOX_ROOT=local_nas/chatbot_docs
# Windows absolute example:
# NAS_INBOX_ROOT=C:/dev/gitlab/my/ContextHub/local_nas/chatbot_docs

# NAS scan loop interval when you add a long-running worker scheduler (seconds)
SCAN_INTERVAL_SECONDS=60

# OpenSearch index name (logical name; DB search uses it only for logging in stub path)
SEARCH_INDEX_NAME=contexthub_chunks

# Chat + indexer SearchClient:
#   `db` (default) | `opensearch_stub` (no HTTP) | `opensearch` (HTTP; requires OPENSEARCH_BASE_URL + index bootstrap)
SEARCH_BACKEND=db

# OpenSearch HTTP base (Compose maps host 9201 → container 9200; avoids common 9200 conflicts). Used when SEARCH_BACKEND=opensearch.
# OPENSEARCH_BASE_URL=http://127.0.0.1:9201
#
# OpenSearch container (docker-compose.yml only): OpenSearch 2.12+ requires OPENSEARCH_INITIAL_ADMIN_PASSWORD for the
# demo security bootstrap step even when plugins.security.disabled=true. That password is fixed in compose for local dev;
# it is NOT read from this file and is unrelated to OPENSEARCH_BASE_URL (the app uses unauthenticated HTTP in this dev stack).

# OpenSearch search tuning (HTTP backend only)
# OPENSEARCH_SEARCH_HIGHLIGHT=true
# OPENSEARCH_SEARCH_EXPLAIN=false

# Indexer: chunk rows per worker cycle (SQL LIMIT). Alias: WORKER_INDEX_BATCH_SIZE (same value).
# Default in app is 1000 for faster dev indexing; use a smaller value in prod if needed.
# INDEXER_BATCH_SIZE=1000

# When true, /api/v1/chat/query and /generate include a ``debug`` object (retrieval metadata; no full chunk_text).
# /generate also adds ``debug.generation_context_chunks`` (text_preview ~300 chars per chunk sent to the LLM).
# POC: set true locally to inspect LLM context in the right-panel Retrieval debug section.
# ENABLE_RETRIEVAL_DEBUG=false

# Parser metadata stored with parse results (stub uses these)
PARSER_NAME=routing
PARSER_VERSION=stub-0.0.0
# HWP/HWPX: subprocess CLI (default node tools/kordoc-cli/parse.mjs). Set KORDOC_ENGINE_CMD in Node env for real kordoc.
# KORDOC_CLI_COMMAND=node tools/kordoc-cli/parse.mjs
# KORDOC_CLI_TIMEOUT_SECONDS=120

# --- LLM (POST /api/v1/chat/generate only; /chat/query stays retrieval stub) ---
# HTTP body는 app/chat/schemas.py 의 ChatQueryRequest — 필수 키는 "question" (/chat/query 와 동일). 필드명 query 아님.
# LLM_MOCK_MODE=true (default) → mock client. false → use LLM_BACKEND.
LLM_MOCK_MODE=true
# LLM_BACKEND=mock | openai_compat | internal_chat | internal_generate (used when LLM_MOCK_MODE=false)
LLM_BACKEND=mock
# LLM_MODEL=model id for OpenAI-compatible chat/completions (mock path still returns model name "mock")
LLM_MODEL=gpt-4o-mini
# NAS RAG (/generate): max completion tokens (default 1000 in app; lower = shorter answers, less runaway generation)
# RAG_LLM_MAX_TOKENS=1000
# If answers still truncate after prompt limits, try 1200 before raising further.
# RAG_LLM_MAX_TOKENS=1200
# Sampling temperature for OpenAI-compatible chat/completions (default 0.2)
# RAG_LLM_TEMPERATURE=0.2
# Selected-document DB fallback: max chunks loaded (effective limit is min(request top_k, this value))
# SELECTED_DOCUMENT_CONTEXT_CHUNKS=5
# HTTP timeout (seconds) for OpenAI-compatible client (urllib)
# OPENAI_COMPAT_TIMEOUT_SECONDS=120
# When LLM_MOCK_MODE=false and LLM_BACKEND=openai_compat:
# OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPAT_API_KEY=sk-...   (optional for local vLLM with no auth — Bearer omitted when unset/empty)
#
# When LLM_MOCK_MODE=false and LLM_BACKEND=internal_chat (corporate /chat API, not OpenAI /v1/chat/completions):
# INTERNAL_CHAT_BASE_URL=http://106.245.249.226:7888
# INTERNAL_CHAT_ENDPOINT=/chat
# INTERNAL_CHAT_TIMEOUT_SECONDS=120
# INTERNAL_CHAT_API_KEY=   (optional; if set, sent as Authorization: Bearer …)
#
# When LLM_MOCK_MODE=false and LLM_BACKEND=internal_generate (corporate POST /api/v1/generate):
# INTERNAL_GENERATE_BASE_URL=http://106.245.249.226:7888
# INTERNAL_GENERATE_ENDPOINT=/api/v1/generate
# INTERNAL_GENERATE_TIMEOUT_SECONDS=120
# INTERNAL_GENERATE_API_KEY=   (optional; if set, sent as Authorization: Bearer …)
